# Copy to .env and fill in:  cp .env.example .env

# Master key that ENCRYPTS the API keys saved in the panel. Required in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If you change it later, saved keys become unreadable (just add them again in the panel).
SECRET_KEY=

# First administrator (created only on the first start, if there is no admin yet).
# Without ADMIN_PASSWORD, a random password is printed in the container log.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Name shown on the sign-in page and in the studio (can be changed later in the panel).
APP_NAME=AI Studio

# Public URL (OpenRouter HTTP-Referer header and Microsoft sign-in redirect).
PUBLIC_URL=http://localhost:3000

# 1 = session cookie only over HTTPS (use behind a proxy with TLS).
COOKIE_SECURE=0

# Port published on the host.
PORT=3000

# Optional: key only from the environment (not stored in the database). The panel takes priority.
# OPENROUTER_API_KEY=

# Other
# SESSION_DAYS=14
# MAX_UPLOAD_MB=200
